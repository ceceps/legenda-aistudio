generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Asset {
  id          String    @id
  projectId   String
  type        AssetType
  name        String
  description String
  imagePrompt String
  imageUrl    String?
  status      JobStatus @default(PENDING)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  Project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model AudioAsset {
  id         String    @id
  projectId  String
  type       AudioType
  sunoPrompt String
  sunoJobId  String?
  audioUrl   String?
  lyrics     String?
  mood       String?
  genre      String?
  status     JobStatus @default(PENDING)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime
  Project    Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Job {
  id        String    @id
  projectId String
  type      String
  status    JobStatus @default(PENDING)
  payload   Json?
  result    Json?
  error     String?
  attempts  Int       @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime
  Project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Project {
  id              String        @id @default(cuid())
  title           String
  status          ProjectStatus @default(DRAFT)
  ide             String
  gaya            StoryStyle
  tokohUtama      String
  asalDaerah      String
  latar           HistoricalEra
  latarDetail     String?
  plot            String
  screenplay      Json?
  storygenerate   String?       @db.Text
  finalVideoUrl   String?
  driveFileId     String?
  driveShareLink  String?
  totalScenes     Int           @default(0)
  completedScenes Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  Asset           Asset[]
  AudioAsset      AudioAsset[]
  Job             Job[]
  Scene           Scene[]
}

model Scene {
  id              String    @id
  projectId       String
  sceneNumber     Int
  title           String
  setting         String
  timeOfDay       String?
  action          String
  voiceOver       String
  musicMood       String?
  actors          String[]
  imagePrompt     String?
  videoPrompt     String?
  cameraAngle     String?
  transition      String?
  storyboardUrl   String?
  clipUrl         String?
  durationSeconds Int       @default(10)
  status          JobStatus @default(PENDING)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  Project         Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, sceneNumber])
}

enum AssetType {
  CHARACTER
  ITEM
  BACKGROUND
}

enum AudioType {
  SOUNDTRACK
  BACKSOUND
  VOICE_OVER
}

enum HistoricalEra {
  SEBELUM_MASEHI
  MASEHI
}

enum JobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ProjectStatus {
  DRAFT
  STORY_GENERATING
  STORY_DONE
  ASSETS_GENERATING
  ASSETS_DONE
  AUDIO_GENERATING
  AUDIO_DONE
  STORYBOARD_GENERATING
  STORYBOARD_DONE
  VIDEO_GENERATING
  VIDEO_DONE
  ASSEMBLING
  COMPLETED
  FAILED
}

enum StoryStyle {
  KLASIK
  SAAT_INI
  FUTURISTIK
  SUPER_HERO
}
